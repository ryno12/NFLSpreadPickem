# Copy to .env (gitignored) and fill in. Local admin use only — these bypass RLS.

# Supabase → Project Settings → Database → Connection string → URI
# Use SESSION mode (port 5432). Transaction mode (6543) can't run multi-statement DDL.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Only needed for REST/RPC calls, not for schema work.
SUPABASE_URL=https://ezymlqyhacyarsownwth.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
